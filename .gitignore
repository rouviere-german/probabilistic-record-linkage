# Secrets: only .env.example is committed.
.env
.env.*
!.env.example
secrets/
*.key

# Python
__pycache__/
*.py[cod]
.venv/
build/
dist/
*.egg-info/

# Tool caches and reports
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*
coverage.xml
htmlcov/
sbom*.json
requirements-audit.txt

# Runtime state, artifacts and large generated data
var/
artifacts/
data/
mlruns/
*.parquet
*.npz
*.duckdb
*.duckdb.wal
# Benchmark output: the small JSON results are committed as the evidence behind README tables.
bench/results/*
!bench/results/*.json

# Editors / OS
.idea/
.vscode/
.DS_Store
Thumbs.db
