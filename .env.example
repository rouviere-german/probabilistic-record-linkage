# Copy to .env for local runs. Never commit .env. Every variable is optional.
APP_SERVICE_NAME=probabilistic-record-linkage
APP_ENVIRONMENT=dev
APP_LOG_LEVEL=INFO
APP_LOG_JSON=true
APP_HOST=127.0.0.1
APP_PORT=8000
APP_ENABLE_DOCS=false

# Comma-separated lowercase SHA-256 digests of operator API keys (protects /metrics).
# Generate a key with: uv run probabilistic-record-linkage generate-api-key
APP_API_KEY_SHA256=
# Comma-separated explicit origins, e.g. https://app.example.com ("*" is refused).
APP_CORS_ALLOW_ORIGINS=
APP_RATE_LIMIT_PER_SECOND=5
APP_RATE_LIMIT_BURST=20
APP_RATE_LIMIT_MAX_CLIENTS=10000
APP_MAX_BODY_BYTES=8388608
APP_METRICS_REQUIRE_AUTH=true

# Scoped JWTs (HS256). Scopes: link:run entity:read review:write pii:read.
# The secret must be at least 32 characters; without it every /v1 route answers 401.
APP_JWT_SECRET=
APP_JWT_ISSUER=probabilistic-record-linkage
APP_JWT_AUDIENCE=linkage-api
APP_JWT_MAX_TTL_SECONDS=3600

APP_TRACING_EXPORTER=none
# HMAC key (>= 32 characters) that pseudonymizes record ids and principals in logs and traces.
# Unset: a random key per process (pseudonyms then change on restart).
APP_ID_HASH_KEY=

APP_DATA_DIR=var
APP_MODEL_NAME=person-linkage
APP_NICKNAMES_FILE=
# Privacy mode: path of a mounted secret file holding the Bloom-filter key (32-4096 bytes, chmod 600).
APP_PPRL_KEY_FILE=
APP_UPLOAD_MAX_ROWS=20000
APP_JOB_MAX_CONCURRENT=2
APP_JOB_MAX_PER_CLIENT=1
APP_CLUSTER_SIZE_CAP=8
APP_DUCKDB_MEMORY_LIMIT=512MB
